# Packing List — pengaturan web server (Apache / LiteSpeed)

DirectoryIndex index.html
Options -Indexes

# Blokir file yang tidak untuk publik: dokumentasi, konfigurasi deploy, database, skrip Windows, file tersembunyi
<FilesMatch "(\.(md|yml|yaml|sqlite|sqlite-wal|sqlite-shm|bat|log|xlsx|example\.php)|^\..*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Paksa HTTPS di produksi (kamera, PWA & notifikasi butuh HTTPS).
# Aktifkan dengan menghapus tanda # setelah SSL (AutoSSL / Let's Encrypt) terpasang di cPanel.
# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteCond %{HTTPS} !=on
#     RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>
